{
	admin off
	email {$ZEKVAR_ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 1m
		}
	}
	# Access logs stay off: no site block has a log directive. Caddy still writes runtime and HTTP error
	# entries (for example an unreachable upstream), which include the request. The filter drops query strings,
	# which can carry OIDC codes and cursors, and credential headers before anything reaches the log.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ""
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>Cookie delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

(pilot_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		>Cache-Control no-store
	}
}

{$ZEKVAR_DASHBOARD_HOST} {
	import pilot_headers
	@eventFeed {
		method GET
		path /v1/integrations/events
		remote_ip {$ZEKVAR_ADMIN_NETWORKS}
	}
	handle @eventFeed {
		reverse_proxy 127.0.0.1:{$ZEKVAR_API_PORT:5187}
	}
	@api path /v1 /v1/*
	handle @api {
		respond 404
	}
	@administrators remote_ip {$ZEKVAR_ADMIN_NETWORKS}
	handle @administrators {
		reverse_proxy 127.0.0.1:{$ZEKVAR_WEB_PORT:3000}
	}
	handle {
		respond 403
	}
}

{$ZEKVAR_BROWSER_HOST} {
	import pilot_headers
	@browserRead {
		method GET
		path /health /v1/browser/policy
	}
	@browserWrite {
		method POST
		path /v1/enroll /v1/browser/heartbeat /v1/browser/events /v1/browser/ai-app-observations /v1/browser/extension-inventory /v1/browser/prompt-exception-requests
	}
	handle @browserRead {
		reverse_proxy 127.0.0.1:{$ZEKVAR_API_PORT:5187}
	}
	handle @browserWrite {
		request_body {
			max_size 128KiB
		}
		reverse_proxy 127.0.0.1:{$ZEKVAR_API_PORT:5187}
	}
	handle {
		respond 404
	}
}
