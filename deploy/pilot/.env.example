ZEKVAR_DASHBOARD_HOST=control.example.com
ZEKVAR_BROWSER_HOST=browser.example.com
ZEKVAR_ACME_EMAIL=admin@example.com
ZEKVAR_ADMIN_NETWORKS="203.0.113.22/32"
ZEKVAR_ORGANIZATION_SLUG=internal-pilot
ZEKVAR_OWNER_TOKEN=
ZEKVAR_POSTGRES_OPERATOR_PASSWORD=
ZEKVAR_POSTGRES_APP_PASSWORD=

# Optional hosted single sign-on
ZEKVAR_OIDC_ISSUER=
ZEKVAR_OIDC_CLIENT_ID=
ZEKVAR_OIDC_CLIENT_SECRET=
ZEKVAR_OIDC_CLIENT_AUTH=basic
ZEKVAR_OIDC_EXCHANGE_TOKEN=
# For organization-specific sign-in, set the JSON array and use indexed OIDC settings on the API.
ZEKVAR_OIDC_ORGANIZATIONS=

# Optional outbound security alert notifications
ZEKVAR_ALERT_WEBHOOK_ENDPOINT=
ZEKVAR_ALERT_WEBHOOK_SIGNING_SECRET=

# Self-service deletion: receipt signing key (openssl rand -hex 32), grace period, and the backup retention stated on receipts.
# Keep ZEKVAR_BACKUP_RETENTION_DAYS equal to the S3 lifecycle rule and local prune period.
ZEKVAR_DELETION_RECEIPT_KEY=
ZEKVAR_DELETION_GRACE_DAYS=7
ZEKVAR_BACKUP_RETENTION_DAYS=35
