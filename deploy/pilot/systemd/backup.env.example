# Copy to /etc/zekvar/backup.env with mode 0600. Use a separate writer identity.
AWS_REGION=us-east-1
ZEKVAR_BACKUP_PROJECT=zekvar-pilot
ZEKVAR_BACKUP_COMPOSE_ENV=/opt/zekvar/deploy/pilot/.env
ZEKVAR_BACKUP_RECIPIENTS=/etc/zekvar/pilot-recipients.txt
ZEKVAR_BACKUP_BUCKET=
ZEKVAR_BACKUP_BUCKET_OWNER=
ZEKVAR_BACKUP_PREFIX=zekvar/pilot
ZEKVAR_BACKUP_RELEASE=
ZEKVAR_BACKUP_KEY_ID=
