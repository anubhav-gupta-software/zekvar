{
  "manifest_version": 3,
  "name": "Zekvar Browser",
  "version": "0.33.0",
  "minimum_chrome_version": "120",
  "description": "Enforces Zekvar domain, AI prompt, clipboard paste, and file upload policies on supported workflows.",
  "permissions": ["storage", "alarms", "declarativeNetRequest"],
  "optional_permissions": ["management", "webNavigation"],
  "storage": { "managed_schema": "managed-schema.json" },
  "host_permissions": ["http://127.0.0.1:5187/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Zekvar Browser" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:4173/zekvar-fixture/"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["claude.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["discovery.js"]
    }
  ]
}
